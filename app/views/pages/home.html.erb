<% content_for :title, "Aegis - Dashboard" %>

<%= render 'shared/sidebar', current_page: 'home' %>

<div class="layout page-home">
  <!-- Top Bar -->
  <div class="topbar">
    <div class="topbar-brand">
      <%= image_tag 'logo_dark_mode.png',  alt: 'Aegis', class: 'brand-logo logo-dark' %>
      <%= image_tag 'logo_light_mode.png', alt: 'Aegis', class: 'brand-logo logo-light' %>
      <div>
        <div class="brand-name">Aegis</div>
        <div class="brand-version">SECURITY PLATFORM v1.0</div>
      </div>
    </div>
    <div class="topbar-meta">
      <div class="live-badge">
        <div class="live-dot"></div>
        SYSTEM ONLINE
      </div>
      <div class="topbar-time" id="clock"></div>
    </div>
  </div>

  <!-- Hero -->
  <div class="hero">
    <div class="hero-greeting">Welcome back, <%= Current.session&.user&.name&.split(' ')&.first&.capitalize || 'Analyst' %></div>
    <h1 class="hero-title">Security Operations Center</h1>
    <p class="hero-sub">Monitor vulnerabilities, manage assets, and coordinate scanning agents from a single command center.</p>
  </div>

  <!-- Stats -->
  <% connected = @agents&.count(&:connected?) || 0 %>
  <div class="stats-row">
    <div class="stat-card red">
      <div class="stat-label">Offline Agents</div>
      <% offline = (@agents&.count || 0) - connected %>
      <div class="stat-value" data-stat="offline_agents"><%= offline %></div>
      <div class="stat-delta <%= offline > 0 ? 'bad' : '' %>" data-stat-delta="offline_agents"><%= offline > 0 ? 'Not reachable' : 'All online' %></div>
    </div>
    <div class="stat-card magenta">
      <div class="stat-label">Total Agents</div>
      <div class="stat-value" data-stat="total_agents"><%= @agents&.count || 0 %></div>
      <div class="stat-delta">Registered agents</div>
    </div>
    <div class="stat-card green">
      <div class="stat-label">Connected Agents</div>
      <div class="stat-value" data-stat="connected_agents"><%= connected %></div>
      <div class="stat-delta <%= connected > 0 ? 'up' : '' %>" data-stat-delta="connected_agents"><%= connected > 0 ? 'Online now' : 'None online' %></div>
    </div>
    <div class="stat-card orange">
      <div class="stat-label">Active Scans</div>
      <div class="stat-value" data-stat="active_scans"><%= @active_scans %></div>
      <div class="stat-delta" data-stat-delta="active_scans"><%= @active_scans.to_i > 0 ? 'Currently running' : 'No scans running' %></div>
    </div>
    <div class="stat-card yellow">
      <div class="stat-label">Last Scan</div>
      <% if @last_scan %>
        <div class="stat-value" data-stat="last_scan" style="font-size:16px;line-height:1.3;margin-top:4px;"><%= time_ago_in_words(@last_scan) %> ago</div>
      <% else %>
        <div class="stat-value" data-stat="last_scan" style="font-size:20px;">Never</div>
      <% end %>
      <div class="stat-delta">Most recent scan</div>
    </div>
    <div class="stat-card cyan">
      <div class="stat-label">Total Assets</div>
      <div class="stat-value" data-stat="total_assets"><%= @assets&.count || 0 %></div>
      <div class="stat-delta">Configured targets</div>
    </div>
    <div class="stat-card teal">
      <div class="stat-label">Scan-Ready Assets</div>
      <% scan_ready = @assets&.count { |a| a.scan_config.present? } || 0 %>
      <div class="stat-value" data-stat="scan_ready_assets"><%= scan_ready %></div>
      <div class="stat-delta" data-stat-delta="scan_ready_assets">With scan config</div>
    </div>
    <div class="stat-card blue">
      <div class="stat-label">Total Sites</div>
      <div class="stat-value" data-stat="total_sites"><%= @sites&.count || 0 %></div>
      <div class="stat-delta">Network sites</div>
    </div>
    <div class="stat-card purple">
      <div class="stat-label">Org Users</div>
      <div class="stat-value" data-stat="users_count"><%= @users_count || 0 %></div>
      <div class="stat-delta">Team members</div>
    </div>
    <div class="stat-card violet">
      <div class="stat-label">Total Reports</div>
      <div class="stat-value" data-stat="total_reports"><%= @reports&.count || 0 %></div>
      <div class="stat-delta">Scan reports</div>
    </div>
  </div>

  <!-- Navigation Cards -->
  <div class="section-header">Navigate</div>
  <div class="nav-grid">
    <% if admin? %>
      <a href="<%= scans_path rescue '#' %>" class="nav-card nav-orange">
        <div class="card-arrow">→</div>
        <div class="card-icon-wrap">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div>
          <div class="card-title">Scan History</div>
          <div class="card-desc">View past scans, track status, and access generated reports.</div>
        </div>
        <div class="card-tag">SCANNER</div>
      </a>
      <a href="<%= scanner_path rescue '#' %>" class="nav-card nav-red">
        <div class="card-arrow">→</div>
        <div class="card-icon-wrap">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/></svg>
        </div>
        <div>
          <div class="card-title">Scanner</div>
          <div class="card-desc">Configure scan parameters, select targets and exploit filters.</div>
        </div>
        <div class="card-tag">SCANNER</div>
      </a>
      <a href="<%= assets_path %>" class="nav-card nav-cyan">
        <div class="card-arrow">→</div>
        <div class="card-icon-wrap">
          <%= image_tag 'SDimagesWhite/AssetMangerWhite.png', alt: '', class: 'card-icon-img icon-white' %>
          <%= image_tag 'SDimagesBlack/AssetMangerBLack.png', alt: '', class: 'card-icon-img icon-black' %>
        </div>
        <div>
          <div class="card-title">Asset Management</div>
          <div class="card-desc">Add, edit, and organize your network targets and scan configurations.</div>
        </div>
        <div class="card-tag">ASSETS</div>
      </a>
      <a href="<%= agents_path rescue '#' %>" class="nav-card nav-magenta">
        <div class="card-arrow">→</div>
        <div class="card-icon-wrap">
          <%= image_tag 'SDimagesWhite/Agent.png', alt: '', class: 'card-icon-img icon-white' %>
          <%= image_tag 'SDimagesBlack/AgentsBlack.png', alt: '', class: 'card-icon-img icon-black' %>
        </div>
        <div>
          <div class="card-title">Agents</div>
          <div class="card-desc">Manage distributed scanning agents deployed across your network.</div>
        </div>
        <div class="card-tag">AGENTS</div>
      </a>
      <a href="<%= sites_path rescue '#' %>" class="nav-card nav-teal">
        <div class="card-arrow">→</div>
        <div class="card-icon-wrap">
          <%= image_tag 'SDimagesWhite/SitesWhite.png', alt: '', class: 'card-icon-img icon-white' %>
          <%= image_tag 'SDimagesBlack/SitesBlack.png', alt: '', class: 'card-icon-img icon-black' %>
        </div>
        <div>
          <div class="card-title">Network Sites</div>
          <div class="card-desc">Organize assets by physical or logical network location.</div>
        </div>
        <div class="card-tag">NETWORK</div>
      </a>
      <a href="<%= scan_profiles_path rescue '#' %>" class="nav-card nav-yellow">
        <div class="card-arrow">→</div>
        <div class="card-icon-wrap">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        </div>
        <div>
          <div class="card-title">Scan Profiles</div>
          <div class="card-desc">Save and manage reusable exploit filter configurations.</div>
        </div>
        <div class="card-tag">PROFILES</div>
      </a>
    <% end %>
    <a href="<%= reports_path rescue '#' %>" class="nav-card nav-violet">
      <div class="card-arrow">→</div>
      <div class="card-icon-wrap">
        <%= image_tag 'SDimagesWhite/VIewReportsWhite.png', alt: '', class: 'card-icon-img icon-white' %>
        <%= image_tag 'SDimagesBlack/ViewReportBlack.png', alt: '', class: 'card-icon-img icon-black' %>
      </div>
      <div>
        <div class="card-title">View Reports</div>
        <div class="card-desc">Review scan results, vulnerability findings, and remediation data.</div>
      </div>
      <div class="card-tag">REPORTS</div>
    </a>
    <% if admin? %>
      <a href="<%= read_only_accounts_path rescue '#' %>" class="nav-card nav-green">
        <div class="card-arrow">→</div>
        <div class="card-icon-wrap">
          <%= image_tag 'SDimagesWhite/ConfigureAccountWhite.png', alt: '', class: 'card-icon-img icon-white' %>
          <%= image_tag 'SDimagesBlack/ConfigureAccounts.png', alt: '', class: 'card-icon-img icon-black' %>
        </div>
        <div>
          <div class="card-title">Configure Accounts</div>
          <div class="card-desc">Create and delete read-only accounts.</div>
        </div>
        <div class="card-tag">CONFIG</div>
      </a>
      <a href="<%= code_analysis_path rescue '#' %>" class="nav-card nav-lime">
        <div class="card-arrow">→</div>
        <div class="card-icon-wrap">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        </div>
        <div>
          <div class="card-title">Code Analysis</div>
          <div class="card-desc">Analyze source code for security vulnerabilities and insecure patterns.</div>
        </div>
        <div class="card-tag">ANALYSIS</div>
      </a>
      <a href="<%= api_docs_path rescue '#' %>" class="nav-card nav-pink">
        <div class="card-arrow">→</div>
        <div class="card-icon-wrap">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
        <div>
          <div class="card-title">API Documentation</div>
          <div class="card-desc">Explore the Aegis REST API reference and integration guides.</div>
        </div>
        <div class="card-tag">DOCS</div>
      </a>
      <a href="<%= settings_path rescue '#' %>" class="nav-card nav-white">
        <div class="card-arrow">→</div>
        <div class="card-icon-wrap">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4.03 3-9 3S3 13.66 3 12"/><path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/></svg>
        </div>
        <div>
          <div class="card-title">Exploit Database</div>
          <div class="card-desc">Browse synced Metasploit modules and refresh the exploit library.</div>
        </div>
        <div class="card-tag">EXPLOITS</div>
      </a>
    <% end %>
    <a href="<%= settings_path rescue '#' %>" class="nav-card nav-blue">
      <div class="card-arrow">→</div>
      <div class="card-icon-wrap">
        <%= image_tag 'SDimagesWhite/SettingsWhite.png', alt: '', class: 'card-icon-img icon-white' %>
        <%= image_tag 'SDimagesBlack/SettingsBlack.png', alt: '', class: 'card-icon-img icon-black' %>
      </div>
      <div>
        <div class="card-title">Settings</div>
        <div class="card-desc">Configure scanner options, API keys, and sync exploits from Metasploit.</div>
      </div>
      <div class="card-tag">CONFIG</div>
    </a>
  </div>

  <!-- Recent Vulnerabilities -->
  <div class="section-header">Recent Vulnerabilities</div>
  <div class="main-card" style="padding:0;overflow:hidden;"
       id="recent-vulns-container"
       data-refresh-url="<%= home_recent_findings_path %>"
       data-refresh-interval="10000">
    <%= render 'recent_findings', recent_findings: @recent_findings %>
  </div>

  <!-- Recent Activity (full width, 2-column) -->
  <div class="panel" style="margin-bottom:24px;">
    <div class="panel-header">
      <div class="panel-title">Recent Activity</div>
    </div>
    <div id="activity-list" style="display:grid;grid-template-columns:1fr 1fr;gap:0;">
      <% if @recent_activity.any? %>
        <% @recent_activity.each do |item| %>
          <div class="activity-item">
            <div class="activity-dot dot-<%= item.color %>"></div>
            <div>
              <div class="activity-text"><%= raw item.text %></div>
              <div class="activity-time"><%= time_ago_in_words(item.created_at) %> ago</div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="activity-item">
          <div class="activity-dot dot-gray"></div>
          <div>
            <div class="activity-text">No activity yet</div>
            <div class="activity-time">—</div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  function updateClock() {
    const now = new Date();
    document.getElementById('clock').textContent =
      now.toLocaleTimeString('en-US', { hour12: false });
  }
  updateClock();
  setInterval(updateClock, 1000);

  (function() {
    var el = document.getElementById('recent-vulns-container');
    if (!el) return;
    setInterval(function() {
      fetch(el.dataset.refreshUrl)
        .then(function(r) { return r.text(); })
        .then(function(html) { el.innerHTML = html; });
    }, parseInt(el.dataset.refreshInterval));
  })();

  function renderActivity(items) {
    const list = document.getElementById('activity-list');
    if (!list) return;
    if (!items || !items.length) {
      list.innerHTML = '<div class="activity-item"><div class="activity-dot dot-gray"></div><div><div class="activity-text">No activity yet</div><div class="activity-time">—</div></div></div>';
      return;
    }
    list.innerHTML = items.map(function(i) {
      return '<div class="activity-item">' +
               '<div class="activity-dot dot-' + i.color + '"></div>' +
               '<div>' +
                 '<div class="activity-text">' + i.text + '</div>' +
                 '<div class="activity-time">' + i.time + '</div>' +
               '</div>' +
             '</div>';
    }).join('');
    list.style.display = 'grid';
    list.style.gridTemplateColumns = '1fr 1fr';
  }

  function pollHomeStats() {
    fetch('/home/stats', { headers: { 'Accept': 'application/json' } })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.stats) {
          Object.keys(data.stats).forEach(function(k) {
            var el = document.querySelector('[data-stat="' + k + '"]');
            if (el) el.textContent = data.stats[k];
          });
        }
        if (data.stat_deltas) {
          Object.keys(data.stat_deltas).forEach(function(k) {
            var el = document.querySelector('[data-stat-delta="' + k + '"]');
            if (el) el.textContent = data.stat_deltas[k];
          });
        }
        if (data.activity) renderActivity(data.activity);
      })
      .catch(function(err) { console.error('Home stats poll failed:', err); });
  }
  pollHomeStats();
  setInterval(pollHomeStats, 10000);
</script>
