# Aegis runtime configuration template.
# Copy to .env and fill in environment-specific values.
# Every variable below is read by config/initializers/aegis_config.rb.

# === Application ===
APP_HOST=localhost
COMPOSE_PROJECT_NAME=aegis

# === Email (Resend) ===
RESEND_API_KEY=

# === Metasploit ===
MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORT=55553
MSF_RPC_USER=msf
MSF_RPC_PASS=                                # required for fast RPC path
MSF_RPC_SSL=false
MSF_MODULES_PATH=/opt/metasploit-framework/embedded/framework/modules/exploits
MSF_AUXILIARY_PATH=/opt/metasploit-framework/embedded/framework/modules/auxiliary
MSFCONSOLE_PATH=                             # auto-detected when blank
MSF_LHOST=127.0.0.1
MSF_LPORT=4444
AEGIS_MSF_DEBUG=1

# === Agent ===
SCANNER_SERVER_IP=localhost
AGENT_SERVER_PORT=3000
AGENT_SOCKS_PORT=1080
AGENT_HEARTBEAT_INTERVAL=30
AGENT_HTTP_TIMEOUT=10
AGENT_RECONNECT_BACKOFF=10
AGENT_TUNNEL_PORT_MIN=9000
AGENT_TUNNEL_PORT_MAX=9999

# === Ollama (LLM) ===
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_READ_TIMEOUT=900
OLLAMA_CODE_MAX_CHARS=30000
OLLAMA_SECURE_CODE_MAX_CHARS=20000

# === NVD enrichment ===
NVD_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_RATE_LIMIT_SLEEP=0.25
NVD_MAX_PER_REQUEST=10

# === Scan tuning ===
SCAN_DEFAULT_TIMEOUT=120
SCAN_TCP_PROBE_PORTS_DIRECT=22,80,443,445,8080
SCAN_TCP_PROBE_PORTS_PROXY=22,80,443,445
SCAN_TCP_PROBE_TIMEOUT=5
SCAN_LOG_RETENTION_DAYS=7

# === Mail (SMTP fallback) ===
SMTP_FROM=scanner@example.com
SMTP_HOST=localhost
SMTP_PORT=25
